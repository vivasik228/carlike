# Публичный домен: оставьте пустым до настройки. Без него preview не индексируется.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_METRIKA_ID=
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Только официальный embed URL из «Поделиться → Код карты»; необязательно.
NEXT_PUBLIC_MAP_EMBED_URL=

# Production: один Node.js сервер и постоянный локальный диск на территории РФ.
STORAGE_REGION=RU
LEADS_DB_PATH=/var/lib/carlike/leads.sqlite
# 32 случайных байта в base64. Генерируйте локально, не публикуйте.
LEAD_ENCRYPTION_KEY=
# Включать только за reverse proxy, который заменяет X-Real-IP.
TRUST_PROXY=false

# До подтверждения оператором production-форма возвращает 503.
LEGAL_APPROVED=false
LEGAL_OPERATOR=
LEGAL_INN=
LEGAL_OGRN=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_RETENTION=

# Только для локальной разработки с синтетическими данными, не production.
ENABLE_DEV_STORAGE=false

# Необязательное уведомление российской CRM: только ID заявки, без ПДн.
CRM_NOTIFY_ENDPOINT=
CRM_NOTIFY_TOKEN=
CRM_REGION=
